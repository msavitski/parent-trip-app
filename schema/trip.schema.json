{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Checklist": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Also the storage key of the ticks: don't rename during a trip.",
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/TextRef"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "items"
      ],
      "title": "Checklist",
      "type": "object"
    },
    "Consulate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phone": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "phone"
      ],
      "title": "Consulate",
      "type": "object"
    },
    "Contact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phone": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "phone"
      ],
      "title": "Contact",
      "type": "object"
    },
    "Currency": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "ISO 4217, e.g. TRY",
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "from": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        }
      },
      "required": [
        "code",
        "symbol",
        "price",
        "from"
      ],
      "title": "Currency",
      "type": "object"
    },
    "Day": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "e.g. 2026-11-03",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hidden": {
          "default": false,
          "description": "Only the admin password shows this day; the family sees \"Plan coming later\" (and its weather).",
          "type": "boolean"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "date",
        "title",
        "events"
      ],
      "title": "Day",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "time": {
          "description": "24-hour local time, e.g. 09:45",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string"
        },
        "icon": {
          "enum": [
            "plane",
            "car",
            "bed",
            "food",
            "coffee",
            "landmark",
            "ship",
            "bag",
            "walk",
            "moon",
            "suitcase"
          ],
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "meet": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "place": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A key of `places`."
        },
        "ticket": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "items": {
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A key of `tickets`, or a list of them (one ticket per person, e.g. [\"busMum\", \"busDad\"])."
        }
      },
      "required": [
        "time",
        "icon",
        "title"
      ],
      "title": "Event",
      "type": "object"
    },
    "Help": {
      "additionalProperties": false,
      "properties": {
        "emergency": {
          "type": "string"
        },
        "family": {
          "description": "The first one gets the big Call button.",
          "items": {
            "$ref": "#/$defs/Contact"
          },
          "minItems": 1,
          "type": "array"
        },
        "lost": {
          "items": {
            "$ref": "#/$defs/TextRef"
          },
          "type": "array"
        },
        "hotel": {
          "description": "A key of `places`.",
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "insurance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Insurance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consulate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Consulate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "emergency",
        "family",
        "lost",
        "hotel"
      ],
      "title": "Help",
      "type": "object"
    },
    "Insurance": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "company",
        "policy",
        "phone"
      ],
      "title": "Insurance",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "local": {
          "$ref": "#/$defs/Currency"
        },
        "home": {
          "$ref": "#/$defs/Currency"
        },
        "pair": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "rate": {
          "description": "1 home = this many local.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "quick": {
          "$ref": "#/$defs/QuickAmounts"
        }
      },
      "required": [
        "local",
        "home",
        "pair",
        "rate",
        "quick"
      ],
      "title": "Money",
      "type": "object"
    },
    "Phrase": {
      "additionalProperties": false,
      "properties": {
        "meaning": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
