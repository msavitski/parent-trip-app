                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "say": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "local": {
          "description": "The phrase in the destination's language.",
          "type": "string"
        },
        "extra": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shown big under the phrase, e.g. a phone number."
        }
      },
      "required": [
        "meaning",
        "say",
        "local"
      ],
      "title": "Phrase",
      "type": "object"
    },
    "Place": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "localName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "As locals write it (taxi card, maps)."
        },
        "address": {
          "description": "As locals write it (taxi card, maps).",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "address"
      ],
      "title": "Place",
      "type": "object"
    },
    "QuickAmounts": {
      "additionalProperties": false,
      "properties": {
        "local": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "home": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "local",
        "home"
      ],
      "title": "QuickAmounts",
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "languages": {
          "description": "Language codes; the first is the fallback.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Force one language; null = the phone's language."
        },
        "speechLang": {
          "default": "",
          "description": "Language spoken at the destination, e.g. \"tr-TR\".",
          "type": "string"
        },
        "demoTodayIsDay": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Demo only: pretend today is this day."
        }
      },
      "required": [
        "languages"
      ],
      "title": "Settings",
      "type": "object"
    },
    "Taxi": {
      "additionalProperties": false,
      "properties": {
        "ask": {
          "description": "\"Please take me to this address\", in the local language.",
          "type": "string"
        }
      },
      "required": [
        "ask"
      ],
      "title": "Taxi",
      "type": "object"
    },
    "TextRef": {
      "title": "TextRef",
      "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
      "tsType": "string | [string] | [string, { [name: string]: string | number }]",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 2
        }
      ]
    },
    "Ticket": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "when": {
          "anyOf": [
            {
              "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
              "type": "string"
            },
            {
              "items": false,
              "maxItems": 2,
              "minItems": 1,
              "prefixItems": [
                {
                  "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "object"
                }
              ],
              "type": "array"
            }
          ],
          "description": "A translation key (\"d1.title\") or a key with values for its placeholders ([\"meet.lobbyAt\", {\"time\": \"09:45\"}]).",
          "tsType": "string | [string] | [string, { [name: string]: string | number }]"
        },
        "code": {
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path inside the data folder, e.g. tickets/flight-out.png"
        },
        "details": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TextRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "when",
        "code"
      ],
      "title": "Ticket",
      "type": "object"
    },
    "Weather": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Weather",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
