{
  // The service worker runs in a worker, not a page: it gets the webworker library instead of the DOM.
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "webworker"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["web/sw.js"]
}
